{
  "name": "Rust & Kotlin Full Stack",
  "image": "mcr.microsoft.com/devcontainers/rust:latest",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem",
      "installGradle": true,
      "gradleVersion": "latest",
      "installMaven": false
    },
    "ghcr.io/mikaello/devcontainer-features/kotlinc:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/java",
    "ghcr.io/mikaello/devcontainer-features/kotlinc"
  ],
  "mounts": [
    "source=rust-cargo-cache,target=/usr/local/cargo/registry,type=volume",
    "source=gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "java.import.gradle.enabled": true
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle"
      ]
    }
  },
  "postCreateCommand": "rustc --version && cargo --version && java -version && kotlinc -version && gradle --version",
  "remoteUser": "vscode"
}
