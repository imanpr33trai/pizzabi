# PIZZORA isolated Rust staging environment template.
#
# Copy this file to infra/.env.rust-staging before running
# `docker compose -f infra/docker-compose.rust-staging.yml up -d --build`.
# Never reuse production database, Redis, JWT, Razorpay, SMTP, or outbox
# credentials in staging. Replace every CHANGE_ME value.
#
# Docker Compose does not use a service's `env_file` for `${VAR}` interpolation.
# Pass the file explicitly from the repository root:
#   docker compose --env-file infra/.env.rust-staging -f infra/docker-compose.rust-staging.yml up -d --build

PIZZORA_ENV=production
RUST_BACKEND_IMAGE=pizzora-rust-backend:staging
API_DATABASE_MAX_POOL_SIZE=15
WORKER_DATABASE_MAX_POOL_SIZE=5

# Isolated PostgreSQL.
STAGING_POSTGRES_DB=pizzora_staging
STAGING_DATABASE_USER=pizzora_staging
STAGING_DATABASE_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
STAGING_POSTGRES_PORT=5433

# Isolated Redis and local mail catcher.
STAGING_REDIS_PORT=6380
STAGING_SMTP_PORT=1026
STAGING_MAILPIT_UI_PORT=8026

# Local host ports for the API and worker.
STAGING_API_PORT=8080
STAGING_WORKER_PORT=8081

# Staging-only authentication and outbox keyring.
# Generate a 32-byte key with: openssl rand -base64 32
STAGING_JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
STAGING_OUTBOX_KEY_CURRENT_ID=k_staging_2026_01
STAGING_OUTBOX_EMAIL_KEYS=k_staging_2026_01:CHANGE_ME_BASE64_32_BYTE_KEY

# Razorpay sandbox/test credentials only.
STAGING_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
STAGING_RAZORPAY_KEY_SECRET=CHANGE_ME
STAGING_RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Object storage is disabled by default in staging. To enable it, set
# STAGING_S3_ENABLED=true and add the standard S3_* variables below; Compose
# passes the env file through to the API and worker containers.
STAGING_S3_ENABLED=false
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=pizzora-staging-product-images
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_PUBLIC_URL=https://staging-cdn.example.com/pizzora-staging-product-images
