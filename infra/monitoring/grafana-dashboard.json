{
  "title": "PIZZORA Production Operations",
  "uid": "pizzora-prod-ops",
  "timezone": "Asia/Kolkata",
  "schemaVersion": 39,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate by Group",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (group) (rate(pizzora_http_requests_total[1m]))", "legendFormat": "{{group}}" }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (group) (rate(pizzora_http_errors_5xx_total[5m]))", "legendFormat": "{{group}}" }
      ]
    },
    {
      "id": 3,
      "title": "Outbox Queue & Stream Sequence",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 6 },
      "targets": [
        { "expr": "pizzora_outbox_unsequenced_total", "legendFormat": "Unsequenced" },
        { "expr": "pizzora_outbox_pending_dispatch_total", "legendFormat": "Pending Dispatch" },
        { "expr": "pizzora_outbox_dead_letter_total", "legendFormat": "Dead Letter" },
        { "expr": "pizzora_stream_last_seq", "legendFormat": "Stream Last Seq" }
      ]
    },
    {
      "id": 4,
      "title": "PostgreSQL Pool (SQLx / HikariCP)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 6 },
      "targets": [
        { "expr": "pizzora_db_pool_connections{state=\"total\"}", "legendFormat": "{{job}} Total DB Conns" },
        { "expr": "pizzora_db_pool_connections{state=\"idle\"}", "legendFormat": "{{job}} Idle DB Conns" },
        { "expr": "pizzora_hikari_connections_active", "legendFormat": "Hikari Active Conns" },
        { "expr": "pizzora_hikari_connections_idle", "legendFormat": "Hikari Idle Conns" },
        { "expr": "pizzora_hikari_threads_awaiting", "legendFormat": "Hikari Threads Awaiting" }
      ]
    },
    {
      "id": 5,
      "title": "Worker Loop Heartbeats",
      "type": "stat",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "targets": [
        { "expr": "time() - pizzora_worker_last_heartbeat_epoch_seconds", "legendFormat": "{{loop}} age (s)" }
      ]
    }
  ]
}
