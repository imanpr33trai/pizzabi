# PIZZORA Railway environment template.
#
# Railway variables are configured per service, not as one shared file. Use this
# as the reference inventory when creating a new isolated stack from
# `.railway/railway.template.ts` or a Railway Dashboard Template.
#
# NEVER point a new template at the live production project (`bubbly-peace`),
# and never commit populated values. On Railway, prefer managed references such
# as `${{postgres.DATABASE_URL}}` and `${{redis.REDIS_URL}}` over copied
# credentials.
#
# Replace every CHANGE_ME value. `PIZZORA_ENV=production` makes startup reject
# missing secrets, short JWT secrets, and known development placeholders.

# ---------------------------------------------------------------------------
# Shared runtime variables (set on both the API and worker services)
# ---------------------------------------------------------------------------
PIZZORA_ENV=production
RUN_MIGRATIONS_ON_STARTUP=false
SHUTDOWN_TIMEOUT_SECS=15
RUST_LOG=info,sqlx::query=warn,tower_http=info

# Prefer the Railway-managed references:
#   DATABASE_URL=${{postgres.DATABASE_URL}}
#   REDIS_URL=${{redis.REDIS_URL}}
DATABASE_URL=postgresql://pizzora:CHANGE_ME@postgres.railway.internal:5432/pizzora
DATABASE_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://redis.railway.internal:6379
REDIS_TIMEOUT_MS=500
REDIS_REQUIRED=false

# Object storage stays disabled unless a path-style-compatible bucket and a
# public S3_PUBLIC_URL are configured. See RUNBOOK section 13.6.
S3_ENABLED=false

# SMTP: use the private mailpit service in staging, or a real relay in production.
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_FROM=no-reply@pizzora.example
SMTP_STARTTLS=true

# ---------------------------------------------------------------------------
# API service (`pizzabi-api`, or `pizzabi` in bubbly-peace)
# ---------------------------------------------------------------------------
PORT=8080
DATABASE_MAX_POOL_SIZE=15
DATABASE_MIN_CONNECTIONS=2

# ---------------------------------------------------------------------------
# Worker service (`pizzabi-worker`)
# ---------------------------------------------------------------------------
# Railway probes $PORT, while pizzora-workers binds $WORKER_HEALTH_PORT. Keep
# both set to 8081 on the worker service.
# PORT=8081
# WORKER_HEALTH_PORT=8081
# DATABASE_MAX_POOL_SIZE=5
# DATABASE_MIN_CONNECTIONS=1
# WORKER_SEQUENCER_POLL_MS=150
# WORKER_DISPATCHER_POLL_MS=150
# WORKER_EXPIRY_SWEEP_MS=15000
# WORKER_RECONCILER_POLL_MS=30000
# WORKER_MAX_ATTEMPTS=5
# WORKER_BATCH_SIZE=10
# WORKER_LEASE_SECONDS=30
# WORKER_OUTBOX_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Secrets (Railway Variables / Template prompts only; never commit values)
# ---------------------------------------------------------------------------
# JWT_SECRET must be at least 32 random characters. Generate with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_ISSUER=pizzora-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WS_TICKET_TTL_SECONDS=30

# Outbox encryption: <kid>:<base64_32byte_key>. Generate the key with:
#   openssl rand -base64 32
OUTBOX_EMAIL_KEY_CURRENT_ID=k_2026_01
OUTBOX_EMAIL_KEYS=k_2026_01:CHANGE_ME

# Razorpay: use rzp_test_* keys in staging and rzp_live_* only in production.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# SMTP credentials (omit when using the staging mailpit sink).
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# Only when S3_ENABLED=true.
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=pizzora-product-images
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_PUBLIC_URL=https://cdn.example.com/pizzora-product-images
