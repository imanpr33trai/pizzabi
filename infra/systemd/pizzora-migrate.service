[Unit]
Description=PIZZORA Pre-Deploy Locked Database Migration (Rust)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=pizzora
Group=pizzora
WorkingDirectory=/opt/pizzora
EnvironmentFile=/etc/pizzora/pizzora.env
Environment=PIZZORA_ENV=production
ExecStart=/usr/local/bin/pizzora-api --migrate-only
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
