# PIZZORA production environment template.
#
# Copy this file to infra/.env.prod for Docker Compose, or to
# /etc/pizzora/pizzora.env for the systemd deployment. Never commit the
# populated file. Replace every CHANGE_ME value with a strong unique value.
#
# Docker Compose does not use a service's `env_file` for `${VAR}` interpolation.
# When invoking Compose from the repository root, pass this file explicitly:
#   docker compose --env-file infra/.env.prod -f infra/docker-compose.prod.yml up -d --build
#
# Docker Compose uses the service names `postgres` and `redis`. For a
# bare-metal/systemd deployment, change the hosts in DATABASE_URL and REDIS_URL
# to 127.0.0.1 (or the reachable database host).

PIZZORA_ENV=production
RUN_MIGRATIONS_ON_STARTUP=false
SHUTDOWN_TIMEOUT_SECS=15
RUST_LOG=info,sqlx::query=warn,tower_http=info

# PostgreSQL. Keep DATABASE_PASSWORD and the password inside DATABASE_URL in sync.
POSTGRES_DB=pizzora_prod
DATABASE_USER=pizzora
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://pizzora:CHANGE_ME_DB_PASSWORD@postgres:5432/pizzora_prod
DATABASE_MAX_POOL_SIZE=15
DATABASE_MIN_CONNECTIONS=2
DATABASE_CONNECT_TIMEOUT_MS=5000

# Redis.
REDIS_URL=redis://redis:6379
REDIS_TIMEOUT_MS=500
REDIS_REQUIRED=false

# Authentication. Generate JWT_SECRET with: openssl rand -base64 48
# The placeholder below is intentionally too short so production startup fails
# until it is replaced.
JWT_SECRET=CHANGE_ME
JWT_ISSUER=pizzora-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WS_TICKET_TTL_SECONDS=30

# Razorpay. Use rzp_live_* keys in production and rzp_test_* only in staging.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# SMTP.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@pizzora.example
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_STARTTLS=true

# Outbox encryption. Generate a 32-byte key with: openssl rand -base64 32
OUTBOX_EMAIL_KEY_CURRENT_ID=k_2026_01
OUTBOX_EMAIL_KEYS=k_2026_01:CHANGE_ME_BASE64_32_BYTE_KEY

# Object storage (optional). Keep disabled unless a path-style-compatible
# bucket and a public S3_PUBLIC_URL are configured.
S3_ENABLED=false
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=pizzora-product-images
# S3_REGION=ap-south-1
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME
# S3_PUBLIC_URL=https://cdn.example.com/pizzora-product-images

# HTTP/WebSocket guardrails.
RATE_LIMIT_ENABLED=true
MAX_JSON_BODY_BYTES=262144
MAX_WEBHOOK_BODY_BYTES=524288
MAX_WS_FRAME_BYTES=65536

# Worker tuning (standalone worker only).
WORKER_HEALTH_PORT=8081
WORKER_SEQUENCER_POLL_MS=150
WORKER_DISPATCHER_POLL_MS=150
WORKER_EXPIRY_SWEEP_MS=15000
WORKER_RECONCILER_POLL_MS=30000
WORKER_MAX_ATTEMPTS=5
WORKER_BATCH_SIZE=10
WORKER_LEASE_SECONDS=30
WORKER_OUTBOX_RETENTION_DAYS=7

# Optional image/pool overrides for Docker Compose.
# RUST_BACKEND_IMAGE=ghcr.io/imanpr33trai/pizzora-rust-backend:1.0.0
# API_DATABASE_MAX_POOL_SIZE=15
# WORKER_DATABASE_MAX_POOL_SIZE=5

# One-shot bootstrap only. Supply these for the initial --bootstrap-owner
# command, then remove them from the persistent runtime environment.
# BOOTSTRAP_OWNER_EMAIL=owner@example.com
# BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME
# BOOTSTRAP_OWNER_NAME=Owner
# BOOTSTRAP_OWNER_PHONE=+91XXXXXXXXXX
