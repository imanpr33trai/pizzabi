{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nemotron-3-ultra-550b-a55b",
  "providers": {
    "nvidia": {
      "models": {
        "Mistral 4 NVIDIA": {
          "modelID": "mistralai/mistral-large-4-1t-a52b",
          "name": "Mistral large 4 nvidia",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
      },
    },
    "opencode-unlimited-proxy": {
      "package": "@ai-sdk/openai-compatible",
      "name": "opencode-unlimited-proxy",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        // Set OPENCODE_UNLIMITED_PROXY_API_KEY in the environment; never commit the key.
        "apiKey": "{env:OPENCODE_UNLIMITED_PROXY_API_KEY}",
      },
      "models": {
        "beam-free": {},
        "big-pickle": {},
        "deepseek-v4.1-flash-free": {
          "name": "DEepseek v4.1 FLASH FREE OPENCODE-UNL-proxy",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "capabilities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["max"] },
          },
        },
        "flint-40b-free": {},
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 FLASH FREE OPENCODE-UNL-proxy",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "capabilities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["max"] },
          },
        },
        "hy4-flash-free": {},
        "iceman-free": {},
        "inkling-2-small-free": {},
        "longcat-2.5-free": {},
        "mimo-v2.6-flash-free": {},
        "nemotron-3.5-lightning-free": {},
        "nemotron-3.5-super-vl-free": {},
      },
    },
    "cc-switch": {
      "package": "@ai-sdk/openai-compatible",
      "name": "cc-switch",
      "settings": {
        "baseURL": "http://127.0.0.1:15721/v1",
        "apiKey": "PROXY_MANAGED",
      },
      "models": {
        "Mistral 4 NVIDIA": {
          "modelID": "mistralai/mistral-large-4-1t-a52b",
          "name": "Mistral large 4 nvidia",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "Kimi-k3.1 pro": {
          "modelID": "moonshotai/kimi-k3.1-pro",
          "name": "moonshotai/kimi-k3.1-pro",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3-Flash",
          "capabilities": {
            "reasoning": { "effort": ["max", "high"], "supported": true },
            "tools": true,
            "input": ["image", "text"],
          },
          "compatibility": { "reasoningField": "reasoning_content" },

          "limit": {
            "context": 1048576,
            "output": 32768,
          },
        },
      },
    },
  },
}
