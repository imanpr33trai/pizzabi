{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-unlimited-proxy/deepseek-v4.1-flash-free",
  "providers": {
    "nvidia": {
      "models": {
        "Mistral 4 NVIDIA": {
          "modelID": "mistralai/mistral-large-4-1t-a52b",
          "name": "Mistral large 4 nvidia",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
        },
      },
    },
    "opencode-unlimited-proxy": {
      "package": "@ai-sdk/openai-compatible",
      "name": "opencode-unlimited-proxy",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-66d8da74611d1f94b84e6f87984345ec",
      },
      "models": {
        "beam-free": {},
        "big-pickle": {},
        "deepseek-v4.1-flash-free": {
          "name": "DEepseek v4.1 FLASH FREE OPENCODE-UNL-proxy",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "capabilities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["max"] },
          },
        },
        "flint-40b-free": {},
        "glm-5.3-flash-free": {
          "name": "GLM 5.3 FLASH FREE OPENCODE-UNL-proxy",
          "limit": {
            "context": 1000000,
            "output": 384000,
          },
          "capabilities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
            "reasoning": { "supported": true, "effort": ["max"] },
          },
        },
        "hy4-flash-free": {},
        "iceman-free": {},
        "inkling-2-small-free": {},
        "longcat-2.5-free": {},
        "mimo-v2.6-flash-free": {},
        "nemotron-3.5-lightning-free": {},
        "nemotron-3.5-super-vl-free": {},
      },
    },
